# Claude Container Environment Variables
# Copy this file to .env and customize as needed
# Usage: docker run --env-file .env ...

# Claude configuration directory (inside container)
CLAUDE_CONFIG_DIR=/home/node/.claude

# GitHub Personal Access Token for gh CLI
# GH_TOKEN=ghp_your_token_here

# Git identity (used for commits inside the container)
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=your.email@example.com

# Timezone (defaults to Europe/Helsinki if not set)
# TZ=America/New_York

# Skip firewall initialization (set to 1 to disable)
# SKIP_FIREWALL=0

# ---- Sudo policy ----
# By default the node user has passwordless sudo for everything (so the agent does too).
# Setting either variable below restricts it. Settings apply at container start; changing
# them requires recreating the container.
#
# Commands node may run with sudo without a password: comma-separated absolute paths,
# optionally with arguments (a trailing "" forbids any arguments). "none" = no commands.
# Commands node can modify (e.g. anything in /usr/local/bin or the home directory) are
# refused. Avoid commands that can start a shell or write files as root (apt-get, vim,
# less, find, tee, cp, npm, docker, ...): allowing one of them grants full root.
# Example - let the agent reload the firewall:
# SUDO_ALLOWED_COMMANDS=/usr/local/sbin/init-firewall.sh
#
# Require a password for all other sudo commands. Set the HASH of a password you choose,
# never the password itself. Generate it with (prompts for the password, prints $6$...):
#   openssl passwd -6
# Keep the single quotes: docker compose would otherwise treat the $ signs as variables.
# SUDO_PASSWORD_HASH='$6$...'

# DinD variants: set to 0 to not start the Docker daemon (default: 1). Docker access is
# equivalent to root, so sudo restrictions only fully apply without it.
# DIND_ENABLED=1

# Playwright browsers path (pre-installed in image)
PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers

# Skip Playwright browser downloads (browsers are pre-installed)
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Notification URL (e.g., ntfy.sh) - called when Claude is idle or needs permission
# Supports any URL that accepts POST requests (ntfy.sh, webhooks, etc.)
# NOTIFICATION_URL=https://ntfy.sh/your-topic-here

# Vaadin Pro/Commercial key (for Charts, Board, Acceleration Kits, etc.)
# Alternatively, mount a ~/.vaadin/proKey file into the container
# VAADIN_PRO_KEY=your-pro-key-here

# Node.js memory limit
NODE_OPTIONS=--max-old-space-size=4096
